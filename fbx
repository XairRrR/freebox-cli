def _on_sigterm(*_):
    """systemd arrête les services par SIGTERM : on le traite comme Ctrl+C pour sortir proprement."""
    raise KeyboardInterrupt

def main():
    p = argparse.ArgumentParser(prog="fbx", description="Surveillance Freebox OS en ligne de commande",
                                formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__.split("\n\n", 2)[2])
    p.add_argument("--url", default=BASE, help=f"URL de la box (défaut {BASE})")
    p.add_argument("-V", "--version", action="version", version=f"%(prog)s {__version__}")
    sp = p.add_subparsers(dest="cmd", required=True)
    sp.add_parser("auth", help="Autoriser l'appli (validation sur l'écran de la box)")
    sp.add_parser("status", help="État complet + diagnostic")
    lg = sp.add_parser("logs", help="Journal de connexion interne de la box")
    lg.add_argument("--save", action="store_true", help="Archiver les entrées dans le journal local")
    sp.add_parser("upnp", help="État WAN via UPnP (sans authentification)")
    h = sp.add_parser("history", help="Historique RRD et coupures détectées")
    h.add_argument("-H", "--hours", type=float, default=24)
    h.add_argument("--json", action="store_true", help="Dump brut des points")
    r = sp.add_parser("report", help="Rapport Markdown des coupures")
    r.add_argument("-H", "--hours", type=float, default=48)
    r.add_argument("-o", "--output", help="Fichier de sortie (sinon stdout)")
    t = sp.add_parser("temp", help="Températures et ventilateur")
    t.add_argument("-H", "--hours", type=float, default=24)
    tr = sp.add_parser("traffic", help="Débits WAN et par port")
    tr.add_argument("-H", "--hours", type=float, default=24)
    sp.add_parser("ports", help="Ports Ethernet/SFP : lien, erreurs, appareils")
    sp.add_parser("wifi", help="Points d'accès et clients Wi-Fi")
    ln = sp.add_parser("lan", help="Appareils du réseau local")
    ln.add_argument("-a", "--active", action="store_true", help="Seulement les appareils actifs")
    w = sp.add_parser("watch", help="Surveillance live + journal des changements")
    w.add_argument("-i", "--interval", type=float, default=10)
    w.add_argument("--headless", action="store_true", help="Sans tableau de bord (pour un service)")
    w.add_argument("--notify", action="store_true", help="Notifications bureau (notify-send) sur changement")
    w.add_argument("--no-ws", action="store_true", help="Ne pas écouter le WebSocket d'évènements")
    w.add_argument("--no-lan", action="store_true", help="Ignorer les évènements d'appareils LAN")
    w.add_argument("--no-screen", action="store_true", help="Ne pas utiliser l'écran alterné")
    e = sp.add_parser("events", help="Flux temps réel des évènements de la box")
    e.add_argument("--no-log", action="store_true", help="Ne pas écrire dans le journal local")
    n = sp.add_parser("notify", help="Notifications push émises par la box")
    n.add_argument("action", choices=["serve", "register", "unregister", "list"])
    n.add_argument("--port", type=int, default=NOTIF_PORT)
    n.add_argument("--target-url", help="URL du récepteur à déclarer (défaut : http://<IP de ce PC>:<port>)")
    n.add_argument("--no-desktop", action="store_true", help="serve : pas de notification bureau")
    n.add_argument("--allow-any", action="store_true", help="serve : accepter des requêtes d'autres IP que la box")
    sv = sp.add_parser("service", help="Services systemd utilisateur (watch + notify)")
    sv.add_argument("action", choices=["install", "uninstall", "status"])
    l2 = sp.add_parser("log", help="Afficher le journal local")
    l2.add_argument("-n", type=int, default=50)
    l2.add_argument("--box", action="store_true", help="Seulement le journal de connexion archivé de la box")
    l2.add_argument("--kind", help="Filtrer par type (change, box_log, box_push, ws, reboot…)")
    l2.add_argument("--all", action="store_true", help="Inclure les évènements d'appareils LAN")
    g = sp.add_parser("get", help="GET brut sur un endpoint")
    g.add_argument("path")
    a = p.parse_args()
    signal.signal(signal.SIGTERM, _on_sigterm)

    no_api = {"log": cmd_log, "upnp": cmd_upnp, "service": cmd_service}
    if a.cmd in no_api:
        return no_api[a.cmd](None, a)
    if a.cmd == "notify" and a.action == "serve":
        return cmd_notify(None, a)
    try:
        fbx = Freebox(a.url)
    except requests.RequestException as e:
        con.print(f"[bold red]API Freebox injoignable sur {a.url}[/] : {e}")
        if a.cmd == "watch":
            log_event("change", {"champ": "box_joignable", "avant": None, "apres": False})
        return 2
    cmds = {"auth": cmd_auth, "status": cmd_status, "logs": cmd_logs, "history": cmd_history, "report": cmd_report,
            "temp": cmd_temp, "traffic": cmd_traffic, "ports": cmd_ports, "wifi": cmd_wifi, "lan": cmd_lan,
            "watch": cmd_watch, "events": cmd_events, "notify": cmd_notify, "get": cmd_get}
    try:
        return cmds[a.cmd](fbx, a)
    except FbxError as e:
        con.print(f"[bold red]Erreur :[/] {e}")
        return 1
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    sys.exit(main() or 0)
