def ws_loop(fbx, on_event, stop=None, events=WS_EVENTS):
    """Écoute ws/event en boucle (reconnexion auto). on_event(source, event, result)."""
    import websocket  # websocket-client
    url = fbx.api.replace("http://", "ws://").replace("https://", "wss://") + "ws/event"
    while not (stop and stop.is_set()):
        try:
            if not fbx.session_token:
                fbx.login()
            ws = websocket.create_connection(url, header=[f"X-Fbx-App-Auth: {fbx.session_token}"], timeout=30)
            ws.send(json.dumps({"action": "register", "events": events}))
            while not (stop and stop.is_set()):
                try:
                    msg = json.loads(ws.recv())
                except websocket.WebSocketTimeoutException:
                    ws.ping()
                    continue
                if msg.get("action") == "notification":
                    on_event(msg.get("source"), msg.get("event"), msg.get("result") or {})
                elif msg.get("action") == "register" and not msg.get("success"):
                    raise FbxError(f"ws register: {msg.get('msg')}")
        except Exception:  # noqa: BLE001 — box rebootée, session expirée… on retente
            fbx.session_token = None
            time.sleep(5)


def ws_record(source, event, result):
    slim = {k: result.get(k) for k in ("id", "primary_name", "name", "host_type", "status", "state", "active")
            if result.get(k) is not None}
    l3 = [x.get("addr") for x in result.get("l3connectivities") or [] if x.get("af") == "ipv4"]
    if l3:
        slim["ipv4"] = l3
    return log_event("ws", {"source": source, "event": event, "result": slim})


def cmd_events(fbx, a):
    fbx.login()
    con.print(f"[dim]Écoute des évènements temps réel ({', '.join(WS_EVENTS)}) — Ctrl+C pour quitter[/]")

    def on_event(source, event, result):
