        w.add_row("Plage ports", f"{conn['ipv4_port_range']} (IP partagée)")
    w.add_row("Débit dispo ↓/↑", f"{fmt_bits(conn.get('bandwidth_down'))} / {fmt_bits(conn.get('bandwidth_up'))}")
    w.add_row("Trafic ↓/↑", f"{fmt_bits((conn.get('rate_down') or 0) * 8)} / {fmt_bits((conn.get('rate_up') or 0) * 8)}")
    w.add_row("Volume session", f"↓ {fmt_bytes(conn.get('bytes_down'))}  ↑ {fmt_bytes(conn.get('bytes_up'))}")
    if ftth:
        rx, tx = dbm(ftth.get("sfp_pwr_rx")), dbm(ftth.get("sfp_pwr_tx"))
        rx_style = ("green" if rx is not None and RX_WARN <= rx <= RX_MAX
                    else ("yellow" if rx is not None and rx >= RX_MIN else "red"))
        w.add_row("SFP fibre", f"{ftth.get('sfp_vendor', '?')} {ftth.get('sfp_model', '')} ({ftth.get('link_type', '?')})")
        w.add_row("Signal / lien PON", Text.assemble(ok(ftth.get("sfp_has_signal")), " / ", ok(ftth.get("link"))))
        w.add_row("Puissance Rx / Tx", Text.assemble(Text("—" if rx is None else f"{rx:.2f} dBm", style=rx_style),
                                                    " / ", "—" if tx is None else f"{tx:.2f} dBm"))
    right = Panel(w if conn else Text(snap.get("conn_err") or "?", style="red"), title="Connexion / Fibre")
    grid.add_row(left, right)

    parts = [grid]
    if net:
        n = "  ".join(f"{k}: " + (f"[green]{v} ms[/]" if isinstance(v, int) and not isinstance(v, bool)
                                  else ("[green]ok[/]" if v is True else "[red]KO[/]")) for k, v in net.items())
        parts.append(Panel(n, title="Test Internet depuis ce PC"))
    if logs:
        lt = Text()
        for e in sorted(logs, key=lambda e: e.get("date", 0))[-6:]:
            lt.append(f"{fmt_ts(e.get('date'))}  ", style="dim")
            lt.append(describe_box_log(e) + "\n", style="green" if e.get("state") == "up" else "red")
        lt.rstrip()
        parts.append(Panel(lt, title="Journal de connexion de la box (depuis son démarrage)"))
    if recent:
        rt = Text()
        for r in recent:
            rt.append(r["ts"].replace("T", " ")[5:] + "  ", style="dim")
            rt.append_text(describe_event(r))
            rt.append("\n")
        rt.rstrip()
        parts.append(Panel(rt, title="Derniers évènements enregistrés"))
    color, msg = verdict(snap)
    parts.append(Panel(msg, title="Diagnostic", border_style=color))
    parts.append(Text(f"Mis à jour {datetime.now():%H:%M:%S}", style="dim"))
    return Group(*parts)


