def series_table(data, fields, title, fmt, labels=None):
    labels = {**SERIES_LABELS, **(labels or {})}
    t = Table(title=title, caption=f"{fmt_ts(data[0]['time'], '%d/%m %H:%M')} → {fmt_ts(data[-1]['time'], '%d/%m %H:%M')}")
    for c in ("Mesure", "Actuel", "Min", "Moy", "Max"):
        t.add_column(c, justify="left" if c == "Mesure" else "right", no_wrap=True)
    width = max(12, con.width - 82)
    t.add_column("Évolution", no_wrap=True, overflow="crop", min_width=width)
    for f in fields:
        vals = [d.get(f) for d in data]
        v = [x for x in vals if x is not None]
        if not v:
            continue
        cur = next((x for x in reversed(vals) if x is not None), None)
        t.add_row(labels.get(f, f), fmt(f, cur), fmt(f, min(v)), fmt(f, sum(v) / len(v)), fmt(f, max(v)),
                  Text(sparkline([(d["time"], d.get(f)) for d in data], width), style="cyan"))
    return t


