class FbxError(Exception):
    def __init__(self, msg, code=None, missing_right=None):
        super().__init__(msg)
        self.code = code
        self.missing_right = missing_right


# ───────────────────────────── client API ─────────────────────────────

class Freebox:
    def __init__(self, base=BASE):
        self.base = base.rstrip("/")
        self.s = requests.Session()
        self.s.headers["User-Agent"] = f"freebox-cli/{APP_VERSION}"
        self.info = self.s.get(f"{self.base}/api_version", timeout=5).json()
        major = self.info["api_version"].split(".")[0]
        self.api = f"{self.base}{self.info.get('api_base_url', '/api/')}v{major}/"
        self.session_token = None
        self.permissions = {}

    def _call(self, method, path, auth=True, **kw):
        url = self.api + path.lstrip("/")
        for attempt in range(2):
            headers = {}
            if auth and self.session_token:
                headers["X-Fbx-App-Auth"] = self.session_token
            r = self.s.request(method, url, headers=headers, timeout=10, **kw)
            try:
                j = r.json()
            except ValueError:
                raise FbxError(f"Réponse non JSON ({r.status_code}) sur {path}")
            if j.get("success"):
                return j.get("result")
            code = j.get("error_code") or j.get("msg")
            if auth and code == "auth_required" and attempt == 0:
                self.login()
                continue
            raise FbxError(f"{path}: {j.get('msg', '?')} [{code}]", code, j.get("missing_right"))

    def get(self, path, **kw):
        return self._call("GET", path, **kw)

    def post(self, path, data=None, **kw):
        return self._call("POST", path, json=data, **kw)

    def delete(self, path, **kw):
        return self._call("DELETE", path, **kw)

    def authorize(self):
        res = self.post("login/authorize/", {
            "app_id": APP_ID, "app_name": APP_NAME, "app_version": APP_VERSION,
            "device_name": socket.gethostname(),
        }, auth=False)
        token, track = res["app_token"], res["track_id"]
        con.print("[bold yellow]➜ Valide la demande sur l'écran de la Freebox Server…[/]")
        with con.status("En attente de validation"):
            while True:
                st = self.get(f"login/authorize/{track}", auth=False)["status"]
                if st != "pending":
                    break
                time.sleep(1)
        if st != "granted":
            raise FbxError(f"Autorisation refusée : {st}")
        CONF_DIR.mkdir(parents=True, exist_ok=True)
        TOKEN_FILE.touch(mode=0o600, exist_ok=True)
        os.chmod(TOKEN_FILE, 0o600)
        TOKEN_FILE.write_text(json.dumps({"app_id": APP_ID, "app_token": token, "uid": self.info.get("uid")}))
        con.print(f"[green]✓ Autorisé. Jeton stocké dans {TOKEN_FILE}[/]")

    def login(self):
        if not TOKEN_FILE.exists():
            raise FbxError("Pas de jeton d'application : lance d'abord `fbx auth`", "no_token")
        tok = json.loads(TOKEN_FILE.read_text())
        app_token, app_id = tok["app_token"], tok.get("app_id", LEGACY_APP_IDS[0])
        challenge = self.get("login/", auth=False)["challenge"]
        pwd = hmac.new(app_token.encode(), challenge.encode(), hashlib.sha1).hexdigest()
        res = self.post("login/session/", {"app_id": app_id, "password": pwd}, auth=False)
        self.session_token = res["session_token"]
        self.permissions = res.get("permissions", {})

    def rrd(self, db, start, end, precision=None):
        # GET + query string : autorisé sans la permission 'settings' (POST la requiert)
        q = {"db": db, "date_start": int(start), "date_end": int(end)}
        if precision:
            q["precision"] = precision
        return self._call("GET", "rrd/", params=q)

    @property
    def host(self):
        return urlparse(self.base).hostname


# ───────────────────────────── UPnP IGD (sans auth) ─────────────────────────────

UPNP_SVC = {
    "ip": ("/control/wan_ip_connection", "urn:schemas-upnp-org:service:WANIPConnection:1"),
    "common": ("/control/wan_common_ifc", "urn:schemas-upnp-org:service:WANCommonInterfaceConfig:1"),
}


def upnp_call(host, svc, action, timeout=4):
    ctrl, urn = UPNP_SVC[svc]
    body = ('<?xml version="1.0"?><s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" '
            's:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"><s:Body>'
            f'<u:{action} xmlns:u="{urn}"/></s:Body></s:Envelope>')
    r = requests.post(f"http://{host}:{UPNP_PORT}{ctrl}", data=body, timeout=timeout, headers={
        "Content-Type": 'text/xml; charset="utf-8"', "SOAPAction": f'"{urn}#{action}"'})
    return dict(re.findall(r"<New([A-Za-z]+)>([^<]*)<", r.text))


def upnp_status(host):
    out = {}
    for svc, act in (("ip", "GetStatusInfo"), ("ip", "GetExternalIPAddress"), ("common", "GetCommonLinkProperties")):
        try:
            out.update(upnp_call(host, svc, act))
        except requests.RequestException as e:
            out["error"] = str(e)
            break
    return out


_upnp_host = None


def box_host():
    """IP LAN de la box pour l'UPnP : découverte SSDP, sinon passerelle par défaut.
    (mafreebox.freebox.fr résout vers une IP publique Free, pas vers la box.)"""
    global _upnp_host, UPNP_PORT
    if _upnp_host:
        return _upnp_host
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.settimeout(1.5)
    try:
        s.sendto(b'M-SEARCH * HTTP/1.1\r\nHOST: 239.255.255.250:1900\r\nMAN: "ssdp:discover"\r\nMX: 1\r\n'
                 b'ST: urn:schemas-upnp-org:device:InternetGatewayDevice:1\r\n\r\n', ("239.255.255.250", 1900))
        while True:
            data, _ = s.recvfrom(4096)
            m = re.search(rb"(?im)^LOCATION:\s*http://([0-9.]+):(\d+)/", data)
            if m and b"fbx" in data.lower():
                _upnp_host, UPNP_PORT = m.group(1).decode(), int(m.group(2))
                return _upnp_host
    except OSError:
        pass
    finally:
        s.close()
    try:  # passerelle par défaut
        for ln in Path("/proc/net/route").read_text().splitlines()[1:]:
            f = ln.split()
            if f[1] == "00000000" and f[2] != "00000000":
                _upnp_host = socket.inet_ntoa(int(f[2], 16).to_bytes(4, "little"))
                return _upnp_host
    except OSError:
        pass
    return urlparse(BASE).hostname


# ───────────────────────────── helpers ─────────────────────────────

def ok(b, yes="oui", no="NON"):
    if b is None:
        return Text("?", style="dim")
    return Text(yes, style="green") if b else Text(no, style="bold red")


def fmt_bits(bps):
    if bps is None:
        return "—"
    for unit in ("bit/s", "kbit/s", "Mbit/s", "Gbit/s"):
        if abs(bps) < 1000:
            return f"{bps:.1f} {unit}"
        bps /= 1000
    return f"{bps:.1f} Tbit/s"


def fmt_bytes(n):
    if n is None:
        return "—"
    for unit in ("o", "Ko", "Mo", "Go", "To"):
        if abs(n) < 1024:
            return f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} Po"


def fmt_dur(sec):
    sec = int(sec)
    d, sec = divmod(sec, 86400)
    h, sec = divmod(sec, 3600)
    m, s = divmod(sec, 60)
    out = (f"{d}j " if d else "") + (f"{h}h" if h or d else "") + f"{m:02d}m"
    return out if (d or h) else f"{m}m{s:02d}s"


def fmt_ts(ts, fmt="%d/%m %H:%M:%S"):
    return datetime.fromtimestamp(ts).strftime(fmt) if ts else "—"


def dbm(v):
    return None if v is None else v / 100.0


def safe(fn, *a, **kw):
    try:
        return fn(*a, **kw), None
    except Exception as e:  # noqa: BLE001
        return None, str(e)


SPARK = "▁▂▃▄▅▆▇█"


def sparkline(points, width=40, lo=None, hi=None):
    """points = [(timestamp, valeur|None)] ; découpage par tranches de temps égales
    (le RRD mélange plusieurs résolutions). Tranche sans mesure = espace."""
    pts = [(t, v) for t, v in points if v is not None]
    if not pts:
        return ""
    vals = [v for _, v in pts]
    t0, t1 = points[0][0], points[-1][0]
    span = (t1 - t0) or 1
    acc = [[] for _ in range(width)]
    for t, v in pts:
        acc[min(width - 1, int((t - t0) / span * width))].append(v)
    buckets = [max(c) if c else None for c in acc]
    lo = min(vals) if lo is None else lo
    hi = max(vals) if hi is None else hi
    span = (hi - lo) or 1
    return "".join(" " if b is None else SPARK[min(7, int((b - lo) / span * 7.999))] for b in buckets)


def internet_check():
    """Test côté PC : DNS + TCP vers des hôtes publics."""
    res = {}
    for name, (host, port) in {"1.1.1.1:443": ("1.1.1.1", 443), "8.8.8.8:53": ("8.8.8.8", 53)}.items():
        t = time.monotonic()
        try:
            socket.create_connection((host, port), timeout=3).close()
            res[name] = round((time.monotonic() - t) * 1000)
        except OSError:
            res[name] = None
    try:
        socket.getaddrinfo("free.fr", 443)
        res["dns"] = True
    except OSError:
        res["dns"] = False
    return res


