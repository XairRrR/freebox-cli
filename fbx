            "ts": datetime.now().isoformat(timespec="seconds"), "event": "ws",
            "detail": {"source": source, "event": event, "result": result}}
        con.print(Text.assemble((rec["ts"].replace("T", " ") + "  ", "dim"), describe_event(rec)))
    try:
        ws_loop(fbx, on_event)
    except KeyboardInterrupt:
        pass


