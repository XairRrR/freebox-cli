def key_state(snap):
    sysc, conn, ftth = snap.get("system") or {}, snap.get("conn") or {}, snap.get("ftth") or {}
    up = snap.get("upnp") or {}
    return {
        "box_joignable": snap.get("system") is not None or bool(up.get("ConnectionStatus")),
        "etape6_auth": sysc.get("box_authenticated"),
        "wan": conn.get("state") or ({"Connected": "up"}.get(up.get("ConnectionStatus"), up.get("ConnectionStatus"))),
        "ipv4": conn.get("ipv4") or up.get("ExternalIPAddress"),
        "signal_optique": ftth.get("sfp_has_signal"),
        "lien_pon": ftth.get("link"),
        "etape": boot_phase(snap)[0] if (snap.get("system") or snap.get("conn")) else None,
        "uptime_val": sysc.get("uptime_val"),
    }


ALERT_FIELDS = {"box_joignable", "etape", "etape6_auth", "wan", "signal_optique", "lien_pon", "internet_pc"}


def cmd_watch(fbx, a):
    stop = threading.Event()
    try:
        fbx.login()
    except Exception as e:  # noqa: BLE001
        con.print(f"[yellow]API indisponible ({e}) — surveillance via UPnP et tests réseau uniquement.[/]")
    log_event("watch_start", {"interval": a.interval, "headless": a.headless})

    def out(rec):
        if a.headless:
            con.print(Text.assemble((rec["ts"].replace("T", " ") + "  ", "dim"), describe_event(rec)))

    if not a.no_ws:
        def on_ws(source, event, result):
            if a.no_lan and source == "lan":
                return
            out(ws_record(source, event, result))
        def ws_thread():
            while not stop.is_set():
                try:
                    ws_fbx = Freebox(fbx.base)
                    break
                except requests.RequestException:
                    time.sleep(10)
            ws_loop(ws_fbx, on_ws, stop)
        threading.Thread(target=ws_thread, daemon=True).start()

    prev = None

    def tick():
        nonlocal prev
        if not fbx.session_token:
            safe(fbx.login)
        try:
            snap = snapshot(fbx) if fbx.session_token else {"system_err": "API non authentifiée"}
        except Exception as e:  # noqa: BLE001
            snap = {"system_err": str(e)}
        snap["upnp"] = upnp_status(box_host())
        net = internet_check()
        if fbx.session_token:
            for e in safe(sync_box_logs, fbx)[0] or []:
                out({"ts": datetime.fromtimestamp(e["date"]).isoformat(timespec="seconds"), "event": "box_log", "detail": e})
        cur = key_state(snap)
        cur["internet_pc"] = any(isinstance(v, int) and not isinstance(v, bool) for v in net.values())
        if prev is None:
            out(log_event("initial", {k: v for k, v in cur.items() if k != "uptime_val"}))
        else:
            if cur["uptime_val"] is not None and prev["uptime_val"] is not None and cur["uptime_val"] < prev["uptime_val"]:
                out(log_event("reboot", {"uptime_val": cur["uptime_val"]}))
                if a.notify:
                    desktop_notify("Freebox", "La box a redémarré", urgent=True)
            for k in cur:
                if k != "uptime_val" and cur[k] != prev[k]:
                    out(log_event("change", {"champ": k, "avant": prev[k], "apres": cur[k]}))
                    if a.notify and k in ALERT_FIELDS:
                        bad = cur[k] in (False, "down", "going_down", None)
                        desktop_notify("Freebox", f"{k} : {prev[k]} → {cur[k]}", urgent=bad)
        prev = cur
        return snap, net

    try:
        if a.headless:
            while True:
                tick()
                time.sleep(a.interval)
        with Live(console=con, refresh_per_second=2, screen=not a.no_screen) as live:
            while True:
                snap, net = tick()
                recent = [r for r in read_events() if r["event"] in ("change", "reboot", "ws", "box_push", "box_log")][-6:]
                live.update(render_status(snap, net, recent))
                time.sleep(a.interval)
    except KeyboardInterrupt:
        stop.set()


def cmd_log(fbx, a):
    evs = read_events()
    if not evs:
        con.print(f"[dim]Aucun journal ({EVENT_LOG}). Lance `fbx watch` pour en créer un.[/]")
        return
    if a.box:
        evs = [r for r in evs if r["event"] == "box_log"]
    if a.kind:
        evs = [r for r in evs if r["event"] == a.kind]
    elif not a.all:  # les apparitions/disparitions d'appareils LAN noient le reste
        evs = [r for r in evs if not (r["event"] == "ws" and r["detail"].get("source") == "lan")]
    evs.sort(key=lambda r: r["ts"])
    t = Table(title=str(EVENT_LOG))
    t.add_column("Date")
    t.add_column("Source")
    t.add_column("Détail")
    for r in evs[-a.n:]:
        t.add_row(r["ts"].replace("T", " "), r["event"], describe_event(r))
    con.print(t)


SERVICES = {
    "fbx-watch": ("Surveillance Freebox (fbx watch)", "watch --headless --notify --no-lan"),
    "fbx-notify": ("Réception des notifications push de la Freebox", "notify serve"),
}


SYSTEM_UNIT_DIRS = (Path("/usr/lib/systemd/user"), Path("/etc/systemd/user"))


def cmd_service(fbx, a):
    unit_dir = Path.home() / ".config/systemd/user"
    exe = Path(sys.argv[0]).resolve()
    packaged = all(any((d / f"{n}.service").exists() for d in SYSTEM_UNIT_DIRS) for n in SERVICES)
    if a.action == "install":
        unit_dir.mkdir(parents=True, exist_ok=True)
        for name, (desc, args) in ({} if packaged else SERVICES).items():
            (unit_dir / f"{name}.service").write_text(
                f"[Unit]\nDescription={desc}\nAfter=network-online.target\nWants=network-online.target\n\n"
                f"[Service]\nExecStart={sys.executable} {exe} {args}\nRestart=always\nRestartSec=10\n"
                f"Environment=PYTHONUNBUFFERED=1\n\n[Install]\nWantedBy=default.target\n")
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)
        subprocess.run(["systemctl", "--user", "enable", "--now", *[f"{n}.service" for n in SERVICES]], check=False)
        con.print("[green]Services installés et démarrés :[/] " + ", ".join(SERVICES) +
                  "\n[dim]Pour qu'ils tournent sans session ouverte : `loginctl enable-linger $USER`.\n"
                  "Puis `fbx notify register` pour que la box envoie ses notifications à fbx-notify.[/]")
    elif a.action == "uninstall":
        subprocess.run(["systemctl", "--user", "disable", "--now", *[f"{n}.service" for n in SERVICES]], check=False)
        for name in SERVICES:
            if not packaged:
                (unit_dir / f"{name}.service").unlink(missing_ok=True)
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)
        con.print("[green]Services supprimés.[/]")
    else:
        subprocess.run(["systemctl", "--user", "--no-pager", "status", *[f"{n}.service" for n in SERVICES]], check=False)


