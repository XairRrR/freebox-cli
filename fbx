# ───────────────────────────── journal local ─────────────────────────────

def log_event(kind, detail):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    rec = {"ts": datetime.now().isoformat(timespec="seconds"), "event": kind, "detail": detail}
    with _log_lock, EVENT_LOG.open("a") as f:
        f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    return rec


def read_events():
    if not EVENT_LOG.exists():
        return []
    out = []
    for ln in EVENT_LOG.read_text().splitlines():
        try:
            out.append(json.loads(ln))
        except ValueError:
            pass
    return out


def describe_event(r):
    d, ev = r["detail"], r["event"]
    if ev == "change" and d.get("champ") == "etape":
        return Text(f"étape {d['avant']} → {d['apres']}", style="green" if d["apres"] == "8" else "bold red")
    if ev == "change":
        bad = d["apres"] in (False, "down", "going_down", None)
        return Text(f"{d['champ']}: {d['avant']} → {d['apres']}", style="red" if bad else "green")
    if ev == "box_log":
        return Text(describe_box_log(d), style="green" if d.get("state") == "up" else "red")
    if ev == "box_push":
        p = d.get("payload") or {}
        return Text(f"{p.get('type', '?')}: {p.get('event', '?')}  {json.dumps(p.get('data') or '', ensure_ascii=False)[:60]}",
                    style="bold magenta")
    if ev == "ws":
        res = d.get("result") or {}
        name = res.get("primary_name") or res.get("name") or res.get("id", "")
        return Text(f"{d.get('source')}_{d.get('event')}  {name}",
                    style="yellow" if "unreachable" in d.get("event", "") else "cyan")
    if ev == "initial":
        return Text("état initial : " + ", ".join(f"{k}={v}" for k, v in d.items()), style="dim")
    if ev == "reboot":
        return Text("La box a redémarré", style="bold red")
    return Text(json.dumps(d, ensure_ascii=False)[:120], style="dim")


# ───────────────────────────── journal de connexion de la box ─────────────────────────────

CONN_NAMES = {"ftth_pub": "Fibre (IP publique)", "ftth_priv": "Fibre (privée/services)", "backup_4g": "Backup 4G",
              "xdsl_pub": "xDSL", "vdsl_pub": "VDSL", "lanwan_pub": "WAN Ethernet"}


def describe_box_log(e):
    if e.get("type") == "link":
        bw = f"  ↓{fmt_bits(e.get('bw_down'))} ↑{fmt_bits(e.get('bw_up'))}" if e.get("state") == "up" else ""
        return f"Lien {e.get('link', '?')} {e.get('state', '?')}{bw}"
    name = CONN_NAMES.get(e.get("conn"), e.get("conn", "?"))
    return f"Connexion {name} {e.get('state', '?')}"


def box_log_key(e):
    return f"{e.get('date')}|{e.get('type')}|{e.get('conn') or e.get('link')}|{e.get('state')}"


def sync_box_logs(fbx):
    """Archive dans le journal local les entrées de connection/logs/ pas encore vues
    (la box efface ce journal à chaque redémarrage). Retourne les nouvelles entrées."""
    entries = fbx.get("connection/logs/") or []
    seen = {box_log_key(r["detail"]) for r in read_events() if r["event"] == "box_log"}
    new = []
    for e in sorted(entries, key=lambda e: e.get("date", 0)):
        if box_log_key(e) not in seen:
            rec = {"ts": datetime.fromtimestamp(e["date"]).isoformat(timespec="seconds"), "event": "box_log", "detail": e}
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            with _log_lock, EVENT_LOG.open("a") as f:
                f.write(json.dumps(rec, ensure_ascii=False) + "\n")
            new.append(e)
    return new


# ───────────────────────────── collecte & verdict ─────────────────────────────

def snapshot(fbx):
    snap = {"ts": time.time()}
    snap["system"], snap["system_err"] = safe(fbx.get, "system/")
    full, err = safe(fbx.get, "connection/full/")
    if full is None:  # repli sur les endpoints documentés
        full, err = safe(fbx.get, "connection/")
        if full is not None:
            full["ftth"], _ = safe(fbx.get, "connection/ftth/")
    snap["conn"], snap["conn_err"] = full, err
    snap["ftth"] = (full or {}).get("ftth")
    snap["update"], _ = safe(fbx.get, "update/")
    snap["logs"], _ = safe(fbx.get, "connection/logs/")
    return snap


RX_MIN, RX_WARN, RX_MAX = -28.0, -25.0, -8.0  # plages PON usuelles (dBm)


def boot_phase(snap):
    """Étape de démarrage Freebox déduite des indicateurs de l'API (cf. assistance.free.fr/articles/311).
    Retourne (code, libellé, responsable)."""
    sysc, conn, ftth = snap.get("system") or {}, snap.get("conn") or {}, snap.get("ftth") or {}
    if not sysc and not conn:
        return "?", "Box injoignable", "?"
    if ftth:
        if not ftth.get("sfp_present") or not ftth.get("sfp_alim_ok"):
            return "1", "Module fibre absent ou non alimenté", "matériel (box)"
        if not ftth.get("sfp_has_signal"):
            return "2", "Recherche du signal : aucune lumière reçue", "fibre / PM / NRO"
        if not ftth.get("link"):
            return "3", "Signal reçu, enregistrement PON auprès de l'OLT impossible", "équipement fibre Free (OLT)"
    if sysc.get("box_authenticated") is False:
        return "6", "Lien OK mais authentification de la Freebox refusée ou sans réponse", "serveurs d'authentification Free"
    if conn.get("state") != "up":
        return "7", f"Authentifiée, connexion WAN {conn.get('state', '?')}", "configuration WAN Free"
    return "8", "Opérationnelle", "—"


def verdict(snap):
    sysc, conn, ftth = snap.get("system") or {}, snap.get("conn") or {}, snap.get("ftth") or {}
    if not snap.get("system") and not snap.get("conn"):
        up = snap.get("upnp") or {}
        if up.get("ConnectionStatus"):
            return "yellow", (f"API injoignable ({snap.get('system_err')}) — UPnP : WAN {up.get('ConnectionStatus')}, "
                              f"lien {up.get('PhysicalLinkStatus')}")
        return "red", f"Freebox injoignable : {snap.get('system_err')}"
    issues = []
    rx = dbm(ftth.get("sfp_pwr_rx"))
    if ftth:
        if not ftth.get("sfp_present"):
            issues.append(("local", "Module SFP fibre absent / non détecté"))
        elif not ftth.get("sfp_alim_ok"):
            issues.append(("local", "Module SFP non alimenté"))
        elif not ftth.get("sfp_has_signal"):
            issues.append(("ligne", "Aucun signal optique reçu : fibre coupée/débranchée ou panne en amont (PM/NRO)"))
        elif rx is not None and rx < RX_MIN:
            issues.append(("ligne", f"Signal optique trop faible ({rx:.2f} dBm) : fibre dégradée/sale"))
        elif not ftth.get("link"):
            issues.append(("ligne", "Signal optique présent mais pas de lien PON (OLT côté Free)"))
    if sysc and sysc.get("box_authenticated") is False:
        issues.append(("free", "Étape 6 : la box n'est pas authentifiée par le réseau Free "
                               "(lien optique OK mais refus/absence de réponse des serveurs Free)"))
    st = conn.get("state")
    if st and st != "up":
        issues.append(("free" if ftth.get("link") else "ligne", f"Connexion WAN : {st}"))
    if not issues:
        return "green", "Tout est OK : fibre, authentification (étape 6) et WAN opérationnels."
    code, label, who = boot_phase(snap)
    issues.insert(0, ("free" if code in ("3", "6", "7") else ("ligne" if code == "2" else "local"),
                      f"[bold]Bloquée à l'étape {code}[/] : {label} (responsable probable : {who})"))
    where = {"local": "chez toi (matériel)", "ligne": "sur la ligne fibre / réseau d'accès",
             "free": "côté Free (cœur de réseau / authentification)"}
    return "red", "\n".join(f"• {msg}  →  [bold]{where[w]}[/]" for w, msg in issues)


def kv_table():
    t = Table(show_header=False, box=None, pad_edge=False)
    t.add_column(style="cyan", no_wrap=True)
    t.add_column()
    return t


def render_status(snap, net=None, recent=None):
    sysc, conn, ftth = snap.get("system") or {}, snap.get("conn") or {}, snap.get("ftth") or {}
    grid = Table.grid(expand=True, padding=(0, 1))
    grid.add_column(ratio=1)
    grid.add_column(ratio=1)

    t = kv_table()
    mi = sysc.get("model_info") or {}
    t.add_row("Modèle", mi.get("pretty_name") or sysc.get("board_name", "?"))
    upd = (snap.get("update") or {}).get("state")
    t.add_row("Firmware", f"{sysc.get('firmware_version', '?')}" + (f"  ({upd})" if upd else ""))
    t.add_row("Uptime", sysc.get("uptime", "?"))
    if sysc.get("uptime_val") is not None:
        t.add_row("Démarrée le", fmt_ts(time.time() - sysc["uptime_val"], "%d/%m/%Y %H:%M:%S"))
    t.add_row("Étape 6 (auth)", ok(sysc.get("box_authenticated"), "authentifiée", "NON AUTHENTIFIÉE"))
    code, label, who = boot_phase(snap)
    t.add_row("Étape actuelle", Text(f"{code} — {label}", style="green" if code == "8" else "bold red"))
    t.add_row("Disque", sysc.get("disk_status", "?"))
    for s_ in sysc.get("sensors") or []:
        v = s_.get("value")
        t.add_row(f"  {s_.get('name')}", Text(f"{v} °C", style="red" if v and v >= 85 else ("yellow" if v and v >= 75 else "")))
    for f in sysc.get("fans") or []:
        t.add_row(f"  {f.get('name')}", f"{f.get('value')} tr/min")
    left = Panel(t if sysc else Text(snap.get("system_err") or "?", style="red"), title="Système")

    w = kv_table()
    st = conn.get("state")
    w.add_row("État WAN", Text(st or "?", style="green" if st == "up" else "bold red"))
    logs = snap.get("logs") or []
    last_up = max((e["date"] for e in logs if e.get("type") == "conn" and e.get("state") == "up"), default=None)
    if last_up and st == "up":
        w.add_row("Connecté depuis", f"{fmt_ts(last_up)} ({fmt_dur(time.time() - last_up)})")
    w.add_row("Média / type", f"{conn.get('media', '?')} / {conn.get('type', '?')}")
    w.add_row("IPv4", conn.get("ipv4", "—"))
    w.add_row("IPv6", conn.get("ipv6", "—"))
