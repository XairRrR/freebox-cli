PUSH_LABELS = {"pub_up": "Connexion Internet rétablie", "reboot": "La box redémarre", "shut_down": "La box s'éteint",
               "enter_sleep": "La box passe en veille", "first_connection": "Nouvel appareil sur le réseau",
               "missed_call": "Appel manqué", "task_done": "Téléchargement terminé"}


def local_ip_towards(host):
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect((socket.gethostbyname(host), 80))
        return s.getsockname()[0]
    finally:
        s.close()


def notif_target_name():
    return f"fbx-cli@{socket.gethostname()}"


def make_notif_handler(notify, allowed_ips):
    class H(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def _allowed(self):
            if allowed_ips is None or self.client_address[0] in allowed_ips:
                return True
            self.send_response(403)
            self.end_headers()
            return False

        def _reply(self, obj):
            b = json.dumps(obj).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(b)))
            self.end_headers()
            self.wfile.write(b)

        def do_POST(self):
            if not self._allowed():
                return
            n = int(self.headers.get("Content-Length") or 0)
            try:
                body = json.loads(self.rfile.read(n) or b"{}")
            except ValueError:
                body = {}
            if self.path.rstrip("/").endswith("/send"):
                payload = body.get("payload") or {}
                rec = log_event("box_push", {"payload": payload, "title": body.get("title"), "body": body.get("body")})
                con.print(Text.assemble((rec["ts"].replace("T", " ") + "  ", "dim"), describe_event(rec)))
                if notify:
                    ev = payload.get("event", "?")
                    desktop_notify("Freebox", PUSH_LABELS.get(ev, f"{payload.get('type')}: {ev}"),
                                   urgent=ev in ("reboot", "shut_down"))
                self._reply({"failureIds": [], "successIds": body.get("devices") or []})
            else:  # /register
                log_event("box_push_register", {"path": self.path, "device_name": body.get("device_name")})
                self._reply({"success": True})

        def do_DELETE(self):
            if not self._allowed():
                return
            log_event("box_push_unregister", {"path": self.path})
            self._reply({"success": True})
    return H


def cmd_notify(fbx, a):
    if a.action == "serve":
        allowed = None if a.allow_any else {box_host(), "127.0.0.1"}
        srv = http.server.ThreadingHTTPServer(("0.0.0.0", a.port), make_notif_handler(not a.no_desktop, allowed))
        con.print(f"[green]Réception des notifications de la box sur le port {a.port}[/] "
                  f"({'toutes sources' if allowed is None else 'source autorisée : ' + ', '.join(sorted(allowed))}) "
                  "— Ctrl+C pour quitter")
        try:
            srv.serve_forever()
        except KeyboardInterrupt:
            pass
        return
    fbx.login()
    targets = fbx.get("notif/targets") or []
    if a.action == "list":
        t = Table(title="Cibles de notification enregistrées sur la box")
        for c in ("Nom", "Type", "Abonnements", "Serveur", "Dernier envoi"):
            t.add_column(c)
        for x in targets:
            t.add_row(x.get("name", "?"), x.get("type", "?"), ", ".join(x.get("subscriptions") or []),
                      x.get("api_url", "?"), fmt_ts(x.get("last_use"), "%d/%m %H:%M") if x.get("last_use") else "—")
        con.print(t)
        return
    mine = [x for x in targets if x.get("name") == notif_target_name()]
    try:
        if a.action == "unregister":
            for x in mine:
                fbx.delete(f"notif/targets/{x['id']}")
            con.print(f"[green]{len(mine)} cible(s) supprimée(s).[/]")
            return
        url = a.target_url or f"http://{local_ip_towards(box_host())}:{a.port}"
        for x in mine:  # ré-enregistrement propre
            fbx.delete(f"notif/targets/{x['id']}")
        fbx.post("notif/targets/", {"name": notif_target_name(), "type": "firebase", "token": APP_ID,
                                    "subscriptions": ["box_state", "lan_host", "password_change"],
                                    "api_url": url, "message_type": "data"})
        con.print(f"[green]✓ La box enverra ses notifications (reboot, extinction, Internet rétabli, nouvel appareil, "
                  f"changement de mot de passe) à {url}[/]\n[dim]Garde `fbx notify serve` actif (ou `fbx service install`).[/]")
    except FbxError as e:
        if e.missing_right == "settings" or e.code == "insufficient_rights":
            con.print("[bold red]Droit manquant : « Modification des réglages ».[/]\n"
                      "Accorde-le dans Freebox OS → Paramètres de la Freebox → Gestion des accès → onglet Applications "
                      "→ « fbx CLI » → cocher « Modification des réglages », puis relance la commande.")
            return 1
        raise


