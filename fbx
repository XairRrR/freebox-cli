def sample_up(d):
    """Point RRD 'up' s'il contient un débit disponible non nul (pendant une
    coupure la box écrit des points vides, sans champ bw_down)."""
    return bool(d.get("bw_down"))


def find_outages(data):
    """[(debut, fin|None, raisons)] à partir des points RRD triés. Le RRD mélange
    plusieurs résolutions : un « trou » = intervalle > 30 min, ou > 6× les voisins."""
    times = [d["time"] for d in data]
    iv = [b - a for a, b in zip(times, times[1:])]
    events, cur = [], None
    for i, d in enumerate(data):
        t_ = d["time"]
        if i > 0:
            gap = iv[i - 1]
            prev_iv = iv[i - 2] if i >= 2 else gap
            next_iv = iv[i] if i < len(iv) else gap
            if gap > 1800 or (gap > 300 and gap > 6 * prev_iv and gap > 6 * next_iv):
                if cur is None:
                    cur = [times[i - 1], None, set()]
                cur[2].add("aucune mesure enregistrée")
        if not sample_up(d):
            if cur is None:
                cur = [t_, None, set()]
            cur[2].add("WAN coupé (points vides)" if "bw_down" not in d else "débit disponible = 0")
        elif cur is not None:
            cur[1] = t_
            events.append(tuple(cur))
            cur = None
    if cur is not None:
        events.append(tuple(cur))
    return events


def fetch_net(fbx, hours):
    end = int(time.time())
    res = fbx.rrd("net", end - int(hours * 3600), end)
    return end, sorted(res.get("data") or [], key=lambda d: d["time"])


def cmd_history(fbx, a):
    fbx.login()
    end, data = fetch_net(fbx, a.hours)
    if not data:
        con.print("[red]Aucune donnée RRD renvoyée.[/]")
        return
    times = [d["time"] for d in data]
    sysc, _ = safe(fbx.get, "system/")
    boot = end - sysc["uptime_val"] if sysc and sysc.get("uptime_val") is not None else None
    con.print(f"[dim]RRD net : {len(data)} points du {fmt_ts(times[0], '%d/%m %H:%M')} au "
              f"{fmt_ts(times[-1], '%d/%m %H:%M')} (résolution variable : 10 s → 2 min → 14 min…)[/]")

    events = find_outages(data)
    width = max(20, min(con.width - 6, 120))
    t0, span = times[0], (times[-1] - times[0]) or 1
    cells = ["up"] * width
    for s_, e, why in events:
        i0 = int((s_ - t0) / span * (width - 1))
        i1 = int(((e or times[-1]) - t0) / span * (width - 1))
        for i in range(i0, i1 + 1):
            cells[i] = "nodata" if why == {"aucune mesure enregistrée"} else "down"
    bar = Text()
    for c in cells:
        bar.append("█" if c != "nodata" else "▒", style={"up": "green", "down": "red", "nodata": "yellow"}[c])
    con.print(Panel(bar, title="Disponibilité WAN  [green]█ OK[/]  [red]█ coupé[/]  [yellow]▒ pas de mesure[/]",
                    subtitle=f"{fmt_ts(t0, '%d/%m %H:%M')}  →  {fmt_ts(times[-1], '%d/%m %H:%M')}"))
    if not events:
        con.print("[green]Aucune coupure détectée sur la période.[/]")
    else:
        t = Table(title="Coupures détectées")
        for c in ("Début", "Fin", "Durée", "Constat"):
            t.add_column(c)
        total = 0
        for s_, e, why in events:
            dur = (e or end) - s_
            total += dur
            note = " + ".join(sorted(why))
            if boot and s_ <= boot <= (e or end):
                note += f" ; box redémarrée à {fmt_ts(boot, '%H:%M')}"
            t.add_row(fmt_ts(s_), fmt_ts(e) if e else "[red]en cours[/]",
                      Text(fmt_dur(dur), style="bold red" if dur > 3600 else ""), note)
        con.print(t)
        con.print(f"Total coupé : [bold]{fmt_dur(total)}[/] sur {fmt_dur(times[-1] - t0)}. "
                  "[dim]Précision = résolution du RRD à cette date (± 2 min sur 24 h, ± 14 min au-delà).[/]")
    if boot:
        con.print(f"Dernier démarrage de la box : {fmt_ts(boot, '%d/%m/%Y %H:%M:%S')}")
    if a.json:
        print(json.dumps(data))


